# Google Ads API — credenciais
# COPIA este arquivo como `.env` na raiz do workspace (sem o .example) e preenche com seus valores reais.
# `.env` está no .gitignore — NUNCA vai pro git.
# NUNCA cole estes valores em chat, screenshot, ou arquivo versionado.

# Developer token (vem do Tools → API Center dentro do MCC)
GOOGLE_ADS_DEVELOPER_TOKEN=COLE_AQUI

# OAuth 2.0 credentials (vem do Google Cloud Console → APIs & Services → Credentials)
GOOGLE_ADS_CLIENT_ID=COLE_AQUI.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=COLE_AQUI

# Refresh token (gerado uma vez via mcp/get_refresh_token.py)
GOOGLE_ADS_REFRESH_TOKEN=COLE_AQUI

# MCC Customer ID (sem hífens — apenas os 10 dígitos)
# Login Customer ID = ID do MCC, NÃO da conta cliente.
# Ao chamar a API, especifica a conta cliente certa como customer_id em cada request.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=COLE_AQUI
